// Retrieval  of  data  (Simple select query and select with where options (include all relational and logical operators)

SELECT * FROM EMPLOYEE1; 

SELECT EmpNo,
EmpName,
       DOB,
       Salary
FROM EMPLOYEE1
WHERE Salary > 30000
ORDER BY Salary DESC;

SELECT EmpName, DeptNo
FROM EMPLOYEE1
ORDER BY DeptNo DESC, EmpName DESC;

SELECT DISTINCT EdLevel
FROM EMPLOYEE1
ORDER BY EdLevel DESC;

SELECT EmpNo, ProjNo
FROM EMP_PROJ1
WHERE EmpNo <= 'E0100'
ORDER BY EmpNo;

SELECT EmpName, Salary, Bonus FROM EMPLOYEE1
WHERE Gender = ‘M’;

SELECT EmpName, Salary, Comm
FROM EMPLOYEE1
WHERE Salary > 20000
AND Hire_Date > TO_DATE('31-12-2004','DD-MM-YYYY');

SELECT EmpName, Salary, Bonus, Comm
FROM EMPLOYEE1
WHERE (Salary > 22000 AND Bonus = 400)
 OR (Bonus = 500 AND Comm < 1900)
ORDER BY EmpName;

SELECT EmpName, Salary, Bonus, Comm
FROM EMPLOYEE1
WHERE Salary > 22000
  AND Bonus IN (400, 500)
  AND Comm < 1900
ORDER BY EmpName;

SELECT ProjNo, EmpNo, EmpTime
FROM EMP_PROJ1
WHERE ProjNo LIKE 'AD%'
ORDER BY ProjNo, EmpTime;

SELECT EmpNo AS MANAGER_NO, DeptNo FROM EMPLOYEE1 WHERE JOB = 'MANAGER' ORDER BY EmpNo;

 SELECT EmpNo, EmpName, Salary, Bonus
FROM EMPLOYEE1
WHERE Bonus BETWEEN 800 AND 1000
ORDER BY Bonus ASC, EmpNo ASC;

SELECT EmpNo, EmpName, Salary, DeptNo
FROM EMPLOYEE1
WHERE DeptNo BETWEEN 'A00' AND 'C01'
ORDER BY EmpName, EmpNo;

SELECT ProjNo, ProjName
FROM PROJECT1
WHERE ProjName LIKE '%SUPPORT%'
ORDER BY ProjNo;



SELECT DeptNo, DeptName, Location
FROM DEPARTMENT1
WHERE TRIM(DeptNo) LIKE '_1_'
ORDER BY DeptNo;

SELECT EmpName, Salary
FROM EMPLOYEE1
ORDER BY Salary DESC
FETCH FIRST 5 ROWS ONLY;

SELECT EmpName, Salary
FROM EMPLOYEE1
WHERE Job NOT IN ('MANAGER', 'PRESIDENT')
ORDER BY Salary DESC
FETCH FIRST 5 ROWS ONLY;

SELECT ProjNo,
       EXTRACT(YEAR FROM StDate) AS YEAR,
       EXTRACT(MONTH FROM StDate) AS MONTH
FROM PROJECT1
WHERE EndDate = TO_DATE('02-01-2014','DD-MM-YYYY')
ORDER BY ProjNo;

SELECT ProjNo,
MONTHS_BETWEEN(EndDate, StDate) AS MONTHS
FROM PROJECT1;

SELECT EmpNo,
 EmpName,
TO_CHAR(Hire_Date, 'DD-Month-YY') AS HireDate
FROM EMPLOYEE1;

SELECT SYSDATE + 15 AS DATE_AFTER_15_DAYS
FROM DUAL;
SELECT EmpNo,
      EmpName,
       Hire_Date
FROM EMPLOYEE1
WHERE TO_CHAR(Hire_Date, 'MONTH') = 'JUNE';

SELECT TO_DATE('05-08-2026','DD-MM-YYYY') AS DATE_VALUE
FROM DUAL;
SELECT ADD_MONTHS(SYSDATE, 3) AS AFTER_3_MONTHS
FROM DUAL;
SELECT LAST_DAY(SYSDATE) AS LAST_DATE
FROM DUAL;
SELECT MONTHS_BETWEEN(
       TO_DATE('05-08-2026','DD-MM-YYYY'),
       TO_DATE('05-05-2026','DD-MM-YYYY')
       ) AS MONTHS
FROM DUAL;
SELECT NEXT_DAY(SYSDATE,'SUNDAY') AS NEXT_SUNDAY
FROM DUAL;
SELECT ROUND(TO_DATE('15-AUG-2026','DD-MON-YYYY'),'MONTH') AS ROUND_DATE
FROM DUAL;
SELECT TRUNC(SYSDATE,'MONTH') AS FIRST_DAY
FROM DUAL;


SELECT TO_CHAR(SYSDATE, 'DDTH Month YYYY') AS DATE_FORMAT
FROM DUAL;
SELECT TO_CHAR(SYSDATE, 'DDSP Month YYYY') AS DATE_FORMAT
FROM DUAL;
SELECT TO_CHAR(SYSDATE, 'DDSPTH Month YYYY') AS DATE_FORMAT
FROM DUAL;

SELECT EmpNo,
       EmpName,
       TRUNC(MONTHS_BETWEEN(Hire_Date, DOB)/12) AS AGE
FROM EMPLOYEE1
WHERE TRUNC(MONTHS_BETWEEN(Hire_Date, DOB)/12) < 25
ORDER BY AGE, EmpNo;



 












