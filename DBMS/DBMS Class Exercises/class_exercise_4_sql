-- CLASS EXERCISE: SQL AGGREGATE AND GROUPING QUERIES

SELECT DeptNo,COUNT(EmpNo) AS EMPLOYEE_COUNT,
ROUND(AVG(Salary),2) AS AVERAGE_SALARY,
MAX(Salary) AS MAX_SALARY
FROM EMPLOYEE1
WHERE UPPER(EmpName) LIKE '%A%'
GROUP BY DeptNo
HAVING COUNT(EmpNo) >= 2;

SELECT DeptNo, COUNT(EmpNo) AS EMPLOYEE_COUNT,
ROUND (AVG(Salary),2) AS AVERAGE_SALARY
FROM EMPLOYEE1
WHERE JOB LIKE ‘%MANAGER%’
GROUP BY DeptNo 
HAVING AVG(Salary) > 40000;  

SELECT EXTRACT(YEAR FROM Hire_Date) AS YEAR_OF_JOINING,
COUNT(EmpNo) AS EMPLOYEE_COUNT,
SUM(Salary) AS TOTAL_SALARY,
ROUND(AVG(Salary),2) AS AVERAGE_SALARY
FROM EMPLOYEE1
GROUP BY EXTRACT(YEAR FROM Hire_Date)
HAVING COUNT(EmpNo) > 2
ORDER BY YEAR_OF_JOINING;

SELECT DeptNo,COUNT(EmpNo) AS EMPLOYEE_COUNT,
ROUND(AVG(Salary),2) AS AVERAGE_SALARY
FROM EMPLOYEE1
WHERE EXTRACT(MONTH FROM Hire_Date)=6
GROUP BY DeptNo
HAVING COUNT(EmpNo)>=2;

SELECT job, COUNT(EmpNo) AS EMPLOYEE_COUNT,
ROUND(AVG(SALARY),2) AS AVERAGE_SALARY 
FROM EMPLOYEE1 
WHERE EmpName LIKE 'S%' 
GROUP BY JOB
HAVING COUNT(EmpNo)>1;

SELECT DeptNo, COUNT(Empno) AS EMPLOYEE_COUNT, 
ROUND(AVG(SALARY), 2) AS AVERAGE_SALARY
FROM EMPLOYEE1
WHERE DOB > TO_DATE('01-JAN-1990', 'DD-MON-YYYY') 
GROUP BY DeptNo
HAVING COUNT (EmpNo) >=2;


SELECT EXTRACT(YEAR FROM DOB) AS BIRTH_YEAR,
COUNT(EmpNo) AS EMPLOYEE_COUNT,
MAX(Salary) AS MAX_SALARY,
MIN(Salary) AS MIN_SALARY
FROM EMPLOYEE1
WHERE EmpName LIKE '%A'
GROUP BY EXTRACT(YEAR FROM DOB)
HAVING COUNT(EmpNo) >= 2;

SELECT DeptNo,
SUM(Salary) AS TOTAL_SALARY,
ROUND(AVG(SALARY), 2) AS AVERAGE_SALARY,
COUNT(EmpNo) AS EMPLOYEE_COUNT
FROM EMPLOYEE1 
WHERE JOB LIKE 'A%' 
GROUP BY DeptNo
HAVING SUM(Salary) > 100000;

SELECT EXTRACT(MONTH FROM Hire_Date)  AS HIRE_MONTH,
COUNT(EmpNo) AS EMPLOYEE_COUNT,
ROUND(AVG(SALARY), 2) AS AVERAGE_SALARY
FROM EMPLOYEE1 
GROUP BY  EXTRACT(MONTH FROM Hire_Date)  
HAVING COUNT (EmpNo) >=2;

SELECT DeptNo,Gender,
COUNT(EmpName) AS EMPLOYEE_COUNT,
ROUND(AVG(Salary), 2) AS AVERGE_SALARY
FROM EMPLOYEE1
WHERE EmpName LIKE '%AN%' 
GROUP BY DeptNo, Gender
HAVING COUNT(EmpNo) >=2;

SELECT JOB, EXTRACT(YEAR FROM Hire_Date) AS YEAR_OF_JOINING,
ROUND(AVG(Salary), 2) AS AVERGE_SALARY
FROM EMPLOYEE1 
WHERE Hire_Date > TO_DATE('01-JAN-2015', 'DD-MON-YYYY') 
GROUP BY Job, EXTRACT(YEAR FROM Hire_Date)
 HAVING COUNT(EmpNo) >= 2; 

SELECT DeptNo, COUNT(EmpNo) AS EMPLOYEE_COUNT,
ROUND(AVG(SALARY),2) AS AVERAGE_SALARY 
FROM EMPLOYEE1 
WHERE LENGTH(EmpName) > 5
GROUP BY DeptNo
HAVING AVG(Salary) > 30000;
SELECT EXTRACT(YEAR FROM HIRE_DATE) AS YEAR_OF_JOINING ,
COUNT(EmpNo) AS EMPLOYEE_COUNT,
SUM(BONUS) AS TOTAL_BONUS,
ROUND(AVG(BONUS),2) AS AVERAGE_BONUS 
FROM EMPLOYEE1 
WHERE Job LIKE '%E%' GROUP BY EXTRACT(YEAR FROM Hire_Date) HAVING COUNT(EmpNo) > 2; 

SELECT DeptNo,
COUNT(EmpNo) AS EMPLOYEE_COUNT,
 MAX(Salary) AS MAX_SALARY,
  MIN(Salary) AS MIN_SALARY
FROM EMPLOYEE1
WHERE EmpName LIKE 'A%'
OR EmpName LIKE 'M%'
GROUP BY DeptNo
HAVING COUNT(EmpNo) >= 2;

SELECT Job,
COUNT(EmpNo) AS EMPLOYEE_COUNT,
 ROUND(AVG(Salary), 2) AS AVERAGE_SALARY,
 ROUND(AVG(Comm), 2) AS AVERAGE_COMMISSION
FROM EMPLOYEE1
WHERE Hire_Date < TO_DATE('01-JAN-2015', 'DD-MON-YYYY')
GROUP BY Job
HAVING COUNT(EmpNo) > 2
AND AVG(Salary) > 25000;

SELECT DeptNo,
EXTRACT(YEAR FROM HIRE_DATE) AS YEAR_OF_JOINING ,
COUNT(EmpNo) AS EMPLOYEE_COUNT,
 ROUND(AVG(SALARY),2) AS AVERAGE_SALARY 
FROM EMPLOYEE1
WHERE EmpName LIKE '%R%'
AND Hire_Date > TO_DATE('01-JAN-2014', 'DD-MON-YYYY') 
GROUP BY DeptNo , EXTRACT(YEAR FROM Hire_Date) 
HAVING COUNT(EmpNo) >= 2;

SELECT DeptNo,
 COUNT(EmpNo) AS EMPLOYEE_COUNT,
ROUND(AVG(Salary), 2) AS AVERAGE_SALARY,
ROUND(AVG(Bonus), 2) AS AVERAGE_BONUS
FROM EMPLOYEE1
WHERE EXTRACT(MONTH FROM DOB) = 1
GROUP BY DeptNo
HAVING COUNT(EmpNo) >= 2
AND AVG(Salary) > 30000;


SELECT Job,
COUNT(EmpNo) AS EMPLOYEE_COUNT,
SUM(Salary) AS TOTAL_SALARY,
ROUND(AVG(Salary),2) AS AVERAGE_SALARY
FROM EMPLOYEE1
WHERE EmpName LIKE 'A%'
OR EmpName LIKE 'E%'
OR EmpName LIKE 'I%'
OR EmpName LIKE 'O%'
OR EmpName LIKE 'U%'
GROUP BY Job
HAVING COUNT(EmpNo) >= 2
AND SUM(Salary) > 75000;

SELECT DeptNo,
COUNT(EmpNo) AS EMPLOYEE_COUNT,
ROUND(AVG(Salary),2) AS AVERAGE_SALARY,
MAX(Salary) AS MAX_SALARY
FROM EMPLOYEE1
WHERE Hire_Date < TO_DATE('01-JAN-2015','DD-MON-YYYY')
GROUP BY DeptNo
HAVING COUNT(EmpNo) >= 2;

SELECT DeptNo,
Job,
Gender,
COUNT(EmpNo) AS EMPLOYEE_COUNT,
ROUND(AVG(Salary),2) AS AVERAGE_SALARY,
SUM(Bonus) AS TOTAL_BONUS
FROM EMPLOYEE1
WHERE EmpName LIKE '%A%'
AND Hire_Date > TO_DATE('01-JAN-2010','DD-MON-YYYY')
AND (Job LIKE 'A%' OR Job LIKE 'M%')
GROUP BY DeptNo, Job, Gender
HAVING COUNT(EmpNo) >= 2
AND AVG(Salary) > 30000;
