//Table Design- Using foreign key and Normalization

CREATE TABLE DEPARTMENT1
(
	DeptNo CHAR(5) PRIMARY KEY,
	DeptName VARCHAR2(35),
	Location VARCHAR2(15)
);

CREATE TABLE EMPLOYEE1(
  2       EmpNo CHAR(10) NOT NULL,
  3      EmpName VARCHAR2(30),
  4      DeptNo CHAR(5),
  5      Mobile CHAR(12),
  6      Hire_Date DATE,
  7      Job VARCHAR2(15),
  8      EdLevel NUMBER(2),
  9      Gender CHAR(1),
 10      DOB DATE,
 11      Salary NUMBER(10,2),
 12      Bonus NUMBER(10,2),
 13      Comm NUMBER(10,2),
 14      CONSTRAINT PK_EMPLOYEE1 PRIMARY KEY(EmpNo),
 15      CONSTRAINT FK_EMPLOYEE1_DEPT
 16          FOREIGN KEY(DeptNo)
 17          REFERENCES DEPARTMENT1(DeptNo),
 18      CONSTRAINT CHK_EMPLOYEE1_EMPNO
 19          CHECK(EmpNo LIKE 'E%'),
 20      CONSTRAINT CHK_EMPLOYEE1_GENDER
 21          CHECK(Gender IN ('M','F')),
 22      CONSTRAINT CHK_EMPLOYEE1_SALARY
 23          CHECK(Salary > 0),
 24      CONSTRAINT CHK_EMPLOYEE1_HIREDATE
 25          CHECK(Hire_Date > DOB)
 26  );



SQL> CREATE TABLE PROJECT1(
  2      ProjNo CHAR(10) NOT NULL,
  3      ProjName VARCHAR2(30),
  4      DeptNo CHAR(5),
  5      ResEmp CHAR(10),
  6      StDate DATE,
  7      EndDate DATE,
  8      CONSTRAINT PK_PROJECT1 PRIMARY KEY(ProjNo),
  9      CONSTRAINT FK_PROJECT1_DEPT
 10          FOREIGN KEY(DeptNo)
 11          REFERENCES DEPARTMENT1(DeptNo),
 12      CONSTRAINT FK_PROJECT1_EMP
 13          FOREIGN KEY(ResEmp)
 14          REFERENCES EMPLOYEE1(EmpNo),
 15      CONSTRAINT CHK_PROJECT1_DATE
 16          CHECK(StDate < EndDate)
 17  );

SQL> CREATE TABLE EMP_PROJ1(
  2      ProjNo CHAR(10),
  3      EmpNo CHAR(10),
  4      EmpTime CHAR(10),
  5   CONSTRAINT PK_EMP_PROJ1 PRIMARY KEY(ProjNo,EmpNo),
  6      CONSTRAINT FK_EMP_PROJ1_PROJECT
  7          FOREIGN KEY(ProjNo)
  8          REFERENCES PROJECT1(ProjNo),
  9      CONSTRAINT FK_EMP_PROJ1_EMPLOYEE
 10          FOREIGN KEY(EmpNo)
 11          REFERENCES EMPLOYEE1(EmpNo)
 12  );


